# .env.example — copy to .env and fill in real values.
# NEVER commit the real .env file. It is git-ignored on purpose.
#
#   cp .env.example .env
#
# For each value below marked [SECRET], see docs/SECRET_ROTATION.md for how to
# generate/rotate it at the relevant provider.

# --- Django -----------------------------------------------------------------

# [SECRET] Random signing key. Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated list of allowed hostnames (no scheme, no port).
# Local dev example: 127.0.0.1,localhost,testserver
# Fly.io example: qs-ai-api.fly.dev
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Optional: comma-separated https origins for CSRF (production only).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://qs-ai-api.fly.dev

# --- PostgreSQL -------------------------------------------------------------

POSTGRES_DB=qs_ai_db
POSTGRES_USER=qs_ai_user
# [SECRET] database password
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker/result backend) ---------------------------

REDIS_URL=redis://127.0.0.1:6379/1

# --- Tigris object storage (S3-compatible) ----------------------------------
# [SECRET] create/rotate these in the Tigris dashboard.

TIGRIS_ACCESS_KEY=
TIGRIS_SECRET_KEY=
TIGRIS_BUCKET=
# Optional: override the default endpoint https://fly.storage.tigris.dev
# TIGRIS_ENDPOINT_URL=https://fly.storage.tigris.dev

# --- OpenAI -----------------------------------------------------------------

# [SECRET] create/rotate at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
